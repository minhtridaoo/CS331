ninja_required_version = 1.3
cxx = /usr/bin/g++-11
nvcc = /usr/local/cuda-12.1/bin/nvcc

cflags = -Wno-unused-result -Wsign-compare -DNDEBUG -g -fwrapv -O2 -Wall -g -fstack-protector-strong -Wformat -Werror=format-security -g -fwrapv -O2 -g -fstack-protector-strong -Wformat -Werror=format-security -Wdate-time -D_FORTIFY_SOURCE=2 -fPIC -DWITH_CUDA -I/mnt/d/MINHTRIHOCCODE/HOCKI5/CS331/CountGDPlusPlus/models/GroundingDINO/ops/src -I/root/.venvs/countgdpp/lib/python3.10/site-packages/torch/include -I/root/.venvs/countgdpp/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/root/.venvs/countgdpp/lib/python3.10/site-packages/torch/include/TH -I/root/.venvs/countgdpp/lib/python3.10/site-packages/torch/include/THC -I/usr/local/cuda-12.1/include -I/root/.venvs/countgdpp/include -I/usr/include/python3.10 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=MultiScaleDeformableAttention -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -DWITH_CUDA -I/mnt/d/MINHTRIHOCCODE/HOCKI5/CS331/CountGDPlusPlus/models/GroundingDINO/ops/src -I/root/.venvs/countgdpp/lib/python3.10/site-packages/torch/include -I/root/.venvs/countgdpp/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/root/.venvs/countgdpp/lib/python3.10/site-packages/torch/include/TH -I/root/.venvs/countgdpp/lib/python3.10/site-packages/torch/include/THC -I/usr/local/cuda-12.1/include -I/root/.venvs/countgdpp/include -I/usr/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DCUDA_HAS_FP16=1 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=MultiScaleDeformableAttention -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 -ccbin /usr/bin/gcc-11 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /mnt/d/MINHTRIHOCCODE/HOCKI5/CS331/CountGDPlusPlus/models/GroundingDINO/ops/build/temp.linux-x86_64-3.10/mnt/d/MINHTRIHOCCODE/HOCKI5/CS331/CountGDPlusPlus/models/GroundingDINO/ops/src/cpu/ms_deform_attn_cpu.o: compile /mnt/d/MINHTRIHOCCODE/HOCKI5/CS331/CountGDPlusPlus/models/GroundingDINO/ops/src/cpu/ms_deform_attn_cpu.cpp
build /mnt/d/MINHTRIHOCCODE/HOCKI5/CS331/CountGDPlusPlus/models/GroundingDINO/ops/build/temp.linux-x86_64-3.10/mnt/d/MINHTRIHOCCODE/HOCKI5/CS331/CountGDPlusPlus/models/GroundingDINO/ops/src/cuda/ms_deform_attn_cuda.o: cuda_compile /mnt/d/MINHTRIHOCCODE/HOCKI5/CS331/CountGDPlusPlus/models/GroundingDINO/ops/src/cuda/ms_deform_attn_cuda.cu
build /mnt/d/MINHTRIHOCCODE/HOCKI5/CS331/CountGDPlusPlus/models/GroundingDINO/ops/build/temp.linux-x86_64-3.10/mnt/d/MINHTRIHOCCODE/HOCKI5/CS331/CountGDPlusPlus/models/GroundingDINO/ops/src/vision.o: compile /mnt/d/MINHTRIHOCCODE/HOCKI5/CS331/CountGDPlusPlus/models/GroundingDINO/ops/src/vision.cpp






